# Copia este arquivo para .env na raiz:
#   macOS e Linux:  cp .env.example .env
#   Windows (PowerShell):  Copy-Item .env.example .env
# O comando pnpm dev também cria o .env se ele não existir.
# Não coloca senha de serviço real aqui. Este projeto de exemplo só usa valores locais.

# Porta do site. 43123 evita brigar com outros projetos na 3000.
WEB_PORT=43123

# mock = a loja usa o catálogo que está no código. Não precisa de banco.
# api  = a loja busca os produtos na API (sobe a API antes).
DATA_SOURCE=mock

# URL da API. Só é usada quando DATA_SOURCE=api.
API_URL=http://127.0.0.1:8787

# URL pública do site, para SEO e links absolutos.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Desconto do Pix em porcentagem inteira. 10 significa 10%.
NEXT_PUBLIC_PIX_DISCOUNT=10

# Frete grátis (PAC) a partir deste valor, em centavos. 29900 = R$ 299,00.
# Níveis Bruto e Lenda podem baixar esse piso. A regra está em packages/domain.
NEXT_PUBLIC_FREE_SHIPPING_CENTS=29900

# Senha do /admin. Só o servidor Node lê. Sem prefixo NEXT_PUBLIC_, ela não entra no JavaScript.
# O navegador envia a senha para POST /api/admin/session. O servidor compara com este valor
# (ou com POST /v1/admin/login, quando a API existir) e grava o cookie httpOnly
# pulso_admin_session, válido por 12 horas. Não reutilize em produção.
ADMIN_PASSWORD=pulso-admin

# Segredo que assina o cookie da sessão. Só o servidor lê. Troque antes de publicar.
# Se ficar vazio ou igual a este exemplo, o painel avisa que ainda é o segredo de desenvolvimento.
ADMIN_SESSION_SECRET=pulso-dev-session-change-me

# Porta da API HTTP.
API_PORT=8787

# mock = a API responde com o catálogo em memória.
# postgres = a API lê a tabela products (rode pnpm db:migrate e pnpm db:seed antes).
API_DATA_SOURCE=mock

# Postgres criado pelo docker compose. Usuário, senha e banco são só locais.
DATABASE_URL=postgres://pulso:pulso@127.0.0.1:5432/pulso

# Conta dono do admin novo. A senha fica num arquivo fora do repositório.
# Rode: pnpm --filter @pulso/db create-owner
# ADMIN_OWNER_EMAIL=dono@pulso.local
# ADMIN_OWNER_NAME=Dono
# ADMIN_OWNER_PASSWORD_FILE=/caminho/fora/do/repo/senha-dono.txt

# Redis criado pelo docker compose. Se você apagar esta linha, a API não tenta cache.
REDIS_URL=redis://127.0.0.1:6379

# Sandbox de pagamento da API. Não coloque access token de Mercado Pago nem de Pagar.me.
# auto (ou vazio) = Pix e boleto no Mercado Pago, cartão na Pagar.me.
# mercadopago ou pagarme força o gateway. Nada é cobrado. O id volta como mp_sandbox_ / pm_sandbox_.
PAYMENT_GATEWAY=auto
