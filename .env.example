# Copia este arquivo para .env na raiz:
#   macOS e Linux:  cp .env.example .env
#   Windows (PowerShell):  Copy-Item .env.example .env
# O comando pnpm dev também cria o .env se ele não existir.
# Não coloca senha de serviço real aqui. Este projeto de exemplo só usa valores locais.

# Porta do site. 43123 evita brigar com outros projetos na 3000.
WEB_PORT=43123

# mock = a loja usa o catálogo que está no código. Não precisa de banco.
# api  = a loja busca os produtos na API (sobe a API antes).
DATA_SOURCE=mock

# URL da API. Só é usada quando DATA_SOURCE=api.
API_URL=http://127.0.0.1:8787

# URL pública do site, para SEO e links absolutos.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:43123

# Desconto do Pix em porcentagem inteira. 10 significa 10%.
NEXT_PUBLIC_PIX_DISCOUNT=10

# Frete grátis (PAC) a partir deste valor, em centavos. 29900 = R$ 299,00.
# Níveis Bruto e Lenda podem baixar esse piso. A regra está em packages/domain.
NEXT_PUBLIC_FREE_SHIPPING_CENTS=29900

# O /admin não tem senha neste arquivo. A conta fica em admin_users.
# Crie o dono com pnpm --filter @pulso/db create-owner e as variáveis ADMIN_OWNER_* no fim deste arquivo.

# Segredo que assina o cookie da sessão. Só o servidor lê. Troque antes de publicar.
# Em produção, vazio, curto ou igual a este exemplo faz a API responder 503 no login.
ADMIN_SESSION_SECRET=pulso-dev-session-change-me

# Proxies que podem escrever X-Forwarded-For. Lista separada por vírgula, no IP do socket.
# Atrás de um proxy isto é obrigatório. Sem a lista, todo cliente vira o IP do proxy e o limite de login trava todo mundo junto.
# O site chama a API de servidor para servidor, então o IP do Next também entra nesta lista.
# Mesma máquina: o Next chama a API em 127.0.0.1.
# Proxy na frente e Next em outra rede: TRUSTED_PROXIES=203.0.113.8,10.0.0.5
# Na Vercel (VERCEL=1) o cabeçalho lido é x-vercel-forwarded-for.
# Self-host atrás de um proxy que apaga o x-real-ip do cliente e grava o IP de verdade.
# Sem VERCEL=1 o site só lê esse cabeçalho com TRUSTED_PROXY=1. Ligado na frente do cliente, o cabeçalho pode ser forjado.
# TRUSTED_PROXY=1
# O limite de POST público usa a mesma regra do login: sem o socket nesta lista, X-Forwarded-For é ignorado.
TRUSTED_PROXIES=127.0.0.1

# Origens extras do CORS da vitrine, separadas por vírgula. NEXT_PUBLIC_SITE_URL já entra.
# Em produção, origem fora da lista recebe 403. Lista vazia também recusa qualquer Origin.
# CORS_ORIGINS=https://pulso.example

# Porta da API HTTP.
API_PORT=8787

# mock = a API responde com o catálogo em memória.
# postgres = a API lê a tabela products (rode pnpm db:migrate e pnpm db:seed antes).
API_DATA_SOURCE=mock

# Postgres criado pelo docker compose. Usuário, senha e banco são só locais.
DATABASE_URL=postgres://pulso:pulso@127.0.0.1:5432/pulso

# O seed de exemplo recusa NODE_ENV=production e banco já editado.
# Para regravar de propósito: PULSO_SEED_ALLOW_OVERWRITE=1 pnpm db:seed
# PULSO_SEED_ALLOW_OVERWRITE=1

# CPF cifrado. AES-256-GCM em cpf_enc, HMAC-SHA256 em cpf_hash, id da chave em cpf_key_id.
# As três variáveis vêm juntas. Cada chave são 32 bytes em base64.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem elas, pnpm db:backfill-cpf não grava nada. A coluna cpf em claro não muda.
# CPF_KEY_ID=local-1
# CPF_ENC_KEY=
# CPF_HMAC_KEY=

# Conta dono do admin novo. A senha fica num arquivo fora do repositório.
# Rode: pnpm --filter @pulso/db create-owner
# ADMIN_OWNER_EMAIL=dono@pulso.local
# ADMIN_OWNER_NAME=Dono
# ADMIN_OWNER_PASSWORD_FILE=/caminho/fora/do/repo/senha-dono.txt

# Cookie pulso_admin da API. Em produção o cookie é sempre Secure.
# Fora de produção, false libera HTTP local. O padrão é Secure.
# ADMIN_COOKIE_SECURE=false

# Token de escrita do Blob store pulso-fotos. Sem ele, POST /v1/admin/uploads responde 503.
# BLOB_READ_WRITE_TOKEN=

# Redis criado pelo docker compose. Se você apagar esta linha, a API não tenta cache.
REDIS_URL=redis://127.0.0.1:6379

# Sandbox de pagamento da API. Não coloque access token de Mercado Pago nem de Pagar.me.
# auto (ou vazio) = Pix e boleto no Mercado Pago, cartão na Pagar.me.
# mercadopago ou pagarme força o gateway. Nada é cobrado. O id volta como mp_sandbox_ / pm_sandbox_.
PAYMENT_GATEWAY=auto
